{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SKIP_ENV_VALIDATION=true next build",
    "dev": "pnpm run dev:app",
    "dev:app": "node --env-file .env ./src/server.js",
    "dev:stories": "ladle serve --host 0.0.0.0",
    "preview": "next build && next start",
    "start": "NODE_ENV=production node --env-file .env ./src/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:integration": "vitest --config vitest.integration.config.js run",
    "test:watch": "vitest --watch"
  },
