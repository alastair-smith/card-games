{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SKIP_ENV_VALIDATION=true NEXT_OUTPUT=standalone next build",
    "build:stories": "SKIP_ENV_VALIDATION=true storybook build",
    "dev": "pnpm run dev:app",
    "dev:app": "node --env-file .env.development ./src/server.js",
    "dev:stories": "storybook dev -p 6006 --host 0.0.0.0 --no-open",
    "preview": "next build && next start",
    "start": "NODE_ENV=production node --env-file .env ./src/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:llm": "tsc --noEmit --pretty false",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "SKIP_ENV_VALIDATION=true vitest run --project=unit",
    "test:llm": "SKIP_ENV_VALIDATION=true vitest run --project=unit --reporter=json | jq -r '.testResults[].assertionResults[] | select(.status==\"failed\") | \"TEST: \" + (.ancestorTitles | join(\" > \")) + \" > \" + .title + \"\\nERROR: \" + (.failureMessages[0] | split(\"\\n\") | .[0:2] | join(\"\\n\"))'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:start-server": "node src/server.js",
    "test:integration": "vitest --config vitest.integration.config.js run",
    "test:stories": "SKIP_ENV_VALIDATION=true vitest run --project=storybook",
    "test:watch": "SKIP_ENV_VALIDATION=true vitest --watch --project=unit"
  },
  "dependencies": {
