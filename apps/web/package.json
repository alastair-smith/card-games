{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "SKIP_ENV_VALIDATION=true NEXT_OUTPUT=standalone next build",
    "dev": "pnpm run dev:app",
    "dev:app": "node --env-file .env.development ./src/server.js",
    "dev:stories": "ladle serve --host 0.0.0.0",
    "preview": "next build && next start",
    "start": "NODE_ENV=production node --env-file .env ./src/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:start-server": "node src/server.js",
    "test:integration": "vitest --config vitest.integration.config.js run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.6.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
