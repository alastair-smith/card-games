{
  "$schema": "https://v2-8-10.turborepo.dev/schema.json",
  "agentGuidance": false,
  "noUpdateNotifier": true,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@repo/skills#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/types/brand.ts"],
      "outputs": []
    },
    "typecheck:watch": {
      "dependsOn": ["^typecheck:watch"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:watch": {
      "dependsOn": ["^test:watch"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^test:integration"],
      "outputs": []
    }
  }
}
