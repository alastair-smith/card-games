generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  name  String
  token String @unique

  hostedGames        GameInstance[]       @relation("GameInstanceHost")
  gameInstancePlayer GameInstancePlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameInstance {
  joinCode String @id

  gameType GameType

  hostUserId String
  host       User   @relation("GameInstanceHost", fields: [hostUserId], references: [id])

  gameInstancePlayers GameInstancePlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameInstancePlayer {
  gameInstanceJoinCode String
  gameInstance         GameInstance @relation(fields: [gameInstanceJoinCode], references: [joinCode])

  playerUserId String
  player       User   @relation(fields: [playerUserId], references: [id])

  ready Boolean

  @@id([gameInstanceJoinCode, playerUserId])
}

enum GameType {
  YANIV    @map("Yaniv")
  BLOB     @map("Blob")
  SHITHEAD @map("Shithead")
  FOOL     @map("Fool")
}
