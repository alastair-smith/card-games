generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  name  String
  token String @unique

  hostedGames GameInstance[] @relation("GameInstanceHost")
  playedGames GameInstance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameInstance {
  joinCode String @id

  gameType GameType

  hostUserId String
  host       User    @relation("GameInstanceHost", fields: [hostUserId], references: [id])
  players    User[]
  ready      Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GameType {
  YANIV    @map("Yaniv")
  BLOB     @map("Blob")
  SHITHEAD @map("Shithead")
}
