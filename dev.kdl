layout {
    tab name="dev" focus=true {
        pane split_direction="vertical" {
            pane command="pnpm" {
                args "dev"
            }
            pane command="pnpm" {
                args "dev:stories"
                cwd "apps/web"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="ci" {
        pane split_direction="vertical" {
            pane command="pnpm" {
                args "test"
            }
            pane command="pnpm" {
                args "lint"
            }
        }
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="git" {
        pane command="zsh" {
            args "-c" "git --no-pager log -1; exec zsh"
        }
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
}
