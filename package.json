{
  "name": "@repo/main",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "background-services": "docker compose up -d",
    "build": "turbo run build",
    "dev": "turbo run --log-prefix=none dev",
    "format:check": "biome check --error-on-warnings",
    "format:check:llm": "biome check --error-on-warnings --reporter=github",
    "format:fix": "biome check --write",
    "format:fix:llm": "biome check --write --reporter=github",
    "lint": "pnpm format:check && pnpm typecheck",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "predev": "pnpm run background-services",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "pretest:integration": "pnpm run background-services",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.9"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.34.7"
  }
}
