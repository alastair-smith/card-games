{
  "name": "@repo/main",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run --log-prefix=none dev",
    "dev:tmux": "./scripts/start-tmux.sh",
    "dev:zellij": "./scripts/start-zellij.sh",
    "format:check": "biome check",
    "format:check:llm": "biome check --reporter=github",
    "format:fix": "biome check --write",
    "format:fix:llm": "biome check --write --reporter=github",
    "lint": "pnpm format:check && pnpm typecheck",
    "typecheck": "turbo run typecheck",
    "typecheck:watch": "turbo run typecheck:watch",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.16.0",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.16.0"
  }
}
