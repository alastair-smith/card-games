{
  "name": "@repo/main",
  "private": true,
  "type": "module",
  "scripts": {
    "background-services": "docker compose up -d",
    "build": "turbo run build",
    "dev": "turbo run --log-prefix=none dev",
    "dev:tmux": "./scripts/start-tmux.sh",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "turbo run lint",
    "predev": "pnpm run background-services",
    "prettier": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.5"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.6.5"
  }
}
