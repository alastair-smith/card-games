{
  "name": "@repo/main",
  "private": true,
  "type": "module",
  "scripts": {
    "background-services": "docker compose up -d",
    "build": "turbo run build",
    "dev": "turbo run --log-prefix=none dev",
    "dev:tmux": "./scripts/start-tmux.sh",
    "dev:zellij": "zellij --layout dev.kdl",
    "format:check": "biome check",
    "format:fix": "biome check --write",
    "lint": "pnpm format:check && pnpm typecheck",
    "typecheck": "turbo run typecheck",
    "predev": "pnpm run background-services"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "10.6.5"
  }
}
